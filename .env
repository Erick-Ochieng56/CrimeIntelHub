# Local Docker defaults (safe for development only — change for production)
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DB_NAME=crime_analysis_db
DB_USER=crime_analysis_user
DB_PASSWORD=crime_analysis_password
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
# Host publish ports (local 5432/6379 already in use)
DB_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6380
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api
# Optional self-hosted OSRM (compose profile `routing`)
OSRM_URL=http://osrm:5000
VITE_OSRM_URL=http://localhost:5000
OSRM_PORT=5000
