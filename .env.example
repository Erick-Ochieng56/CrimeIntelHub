# CrimeIntelHub — root env template (copy to `.env`)
# Safe for local Docker only — change secrets before any real deployment.

SECRET_KEY=change-me-generate-a-50-plus-character-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

DB_NAME=crime_analysis_db
DB_USER=crime_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Compose/local PostGIS has no TLS; use require for managed cloud DBs
DB_SSLMODE=disable
# Host publish ports if 5432/6379 are already in use
DB_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6380
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api

# --- Domain deploy (crime.erickochieng.co.ke behind Cloudflare Full (strict)) ---
# Place Cloudflare Origin CA files in deploy/certs/ (origin.pem + origin.key); see deploy/certs/README.md.
# Misconfigured ALLOWED_HOSTS / CORS / VITE_API_BASE_URL will break the domain deploy (Host rejection, blocked browser calls, or wrong baked API URL).
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,crime.erickochieng.co.ke
# FRONTEND_URL=https://crime.erickochieng.co.ke
# CORS_ALLOWED_ORIGINS=https://crime.erickochieng.co.ke
# TRUST_X_FORWARDED_PROTO=true   # enable only behind Cloudflare/nginx; do not enable if :80/:443 are open to the world without CF
# CSRF_TRUSTED_ORIGINS=https://crime.erickochieng.co.ke
# VITE_API_BASE_URL=https://crime.erickochieng.co.ke/api
# FRONTEND_MODE=preview  # build the SPA and let nginx serve it (not vite preview)
# DEBUG=False

# Optional OSRM routing — enable with:
#   docker compose --profile routing up -d osrm
# First run downloads Kenya Geofabrik extract and builds the graph (several minutes).
OSRM_URL=http://osrm:5000
VITE_OSRM_URL=http://localhost:5000
OSRM_PORT=5000
# OSRM_PBF_URL=https://download.geofabrik.de/africa/kenya-latest.osm.pbf

# Email for alert notifications and password resets.
# Console backend prints mail to the backend/worker logs. For real delivery use SMTP:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=change-me
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True

# Background worker (Celery). Compose points the worker at Redis db 1 automatically.
# CELERY_CONCURRENCY=2
# Set True only to run tasks inline without a worker (debugging)
# CELERY_TASK_ALWAYS_EAGER=False

# Optional: redirect HTTP to HTTPS in Django too (needs TRUST_X_FORWARDED_PROTO=True behind a proxy)
# SECURE_SSL_REDIRECT=False
