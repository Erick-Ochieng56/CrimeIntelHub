# Django Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration
DB_NAME=crime_analysis_db
DB_USER=crime_analysis_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://username:password@host:port/database

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGIN_REGEXES=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# GIS Library Paths (Windows)
GDAL_LIBRARY_PATH=C:/OSGeo4W64/bin/gdal304.dll
C:\OSGeo4W\bin
GEOS_LIBRARY_PATH=C:/OSGeo4W64/bin/geos_c.dll
PROJ_LIB=C:/OSGeo4W64/bin/proj_8_2.dll
PROJ_DATA=C:/OSGeo4W64/share/proj
PROJ_DB=C:/OSGeo4W64/share/proj/proj.db

# GIS Library Paths (Linux/Mac)
# GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so
# PROJ_LIB=/usr/lib/x86_64-linux-gnu/libproj.so
# PROJ_DATA=/usr/share/proj
# PROJ_DB=/usr/share/proj/proj.db

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
