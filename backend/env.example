# =============================================================================
# CrimeIntelHub environment
# Prefer Docker for GIS (local + production). Do NOT set Windows GDAL paths
# when running the backend container — libs ship inside the Linux image.
# =============================================================================

# Django
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database (service name "db" inside Compose; use localhost if connecting from host tools)
DB_NAME=crime_analysis_db
DB_USER=crime_analysis_user
DB_PASSWORD=crime_analysis_password
DB_HOST=db
DB_PORT=5432
# Compose/local PostGIS has no TLS; use require for managed cloud DBs
DB_SSLMODE=disable

# Redis
REDIS_URL=redis://redis:6379/0

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api

# --- Domain deploy (crime.erickochieng.co.ke behind Cloudflare Flexible SSL) ---
# Misconfigured ALLOWED_HOSTS / CORS / VITE_API_BASE_URL will break the domain deploy (Host rejection, blocked browser calls, or wrong baked API URL).
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,crime.erickochieng.co.ke
# FRONTEND_URL=https://crime.erickochieng.co.ke
# CORS_ALLOWED_ORIGINS=https://crime.erickochieng.co.ke
# TRUST_X_FORWARDED_PROTO=true   # enable only behind Cloudflare/nginx; do not enable if :80 is open to the world without CF
# CSRF_TRUSTED_ORIGINS=https://crime.erickochieng.co.ke
# VITE_API_BASE_URL=https://crime.erickochieng.co.ke/api
# DEBUG=False

# Optional routing (docker compose --profile routing)
# Backend proxies browser requests to OSRM (service name inside Compose)
OSRM_URL=http://osrm:5000
VITE_OSRM_URL=http://localhost:5000
OSRM_PORT=5000
# OSRM_PBF_URL=https://download.geofabrik.de/africa/kenya-latest.osm.pbf

# Email (console in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# GIS — leave unset in Docker. Only needed for rare bare-metal Linux installs:
# GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so
