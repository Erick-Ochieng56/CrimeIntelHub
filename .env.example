# CrimeIntelHub — root env template (copy to `.env`)
# Safe for local Docker only — change secrets before any real deployment.

SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

DB_NAME=crime_analysis_db
DB_USER=crime_analysis_user
DB_PASSWORD=crime_analysis_password
DB_HOST=db
DB_PORT=5432
# Host publish ports if 5432/6379 are already in use
DB_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6380
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api

# Optional OSRM routing — enable with:
#   docker compose --profile routing up -d osrm
# First run downloads Kenya Geofabrik extract and builds the graph (several minutes).
OSRM_URL=http://osrm:5000
VITE_OSRM_URL=http://localhost:5000
OSRM_PORT=5000
# OSRM_PBF_URL=https://download.geofabrik.de/africa/kenya-latest.osm.pbf
